{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator profile for Lin Htet IT Service backend",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Administrator Google account email"
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "admin"],
          "description": "Role level of the administrator"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when admin access was granted"
        }
      },
      "required": ["email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order record",
      "type": "object",
      "properties": {
        "no": {
          "type": "string",
          "description": "Order number with LH prefix"
        },
        "customer_name": {
          "type": "string",
          "description": "Customer name"
        },
        "contact": {
          "type": "string",
          "description": "Customer phone number or Telegram username"
        },
        "total": {
          "type": "number",
          "description": "Total order amount in MMK"
        },
        "status": {
          "type": "string",
          "enum": ["new", "paid", "delivered", "cancelled"],
          "description": "Order fulfillment status"
        }
      },
      "required": ["no", "customer_name", "contact", "total", "status"]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "Customer price drop alert subscription with Telegram ID",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Target product ID"
        },
        "productName": {
          "type": "string",
          "description": "Target product name"
        },
        "telegramId": {
          "type": "string",
          "description": "User Telegram username or ID"
        },
        "currentPriceAtCreation": {
          "type": "number",
          "description": "Price at alert creation in MMK"
        },
        "targetPrice": {
          "type": "number",
          "description": "Optional custom threshold price in MMK"
        },
        "status": {
          "type": "string",
          "enum": ["active", "notified", "cancelled"],
          "description": "Alert status"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["productId", "productName", "telegramId", "currentPriceAtCreation", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product star rating and feedback comment",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Reviewed product ID"
        },
        "productName": {
          "type": "string",
          "description": "Product name"
        },
        "rating": {
          "type": "number",
          "description": "Star rating between 1 and 5"
        },
        "customerName": {
          "type": "string",
          "description": "Name of the reviewer"
        },
        "comment": {
          "type": "string",
          "description": "Feedback message"
        },
        "verifiedPurchase": {
          "type": "boolean",
          "description": "Whether the reviewer is a verified purchaser"
        },
        "orderNo": {
          "type": "string",
          "description": "Associated purchase order number"
        },
        "helpfulCount": {
          "type": "number",
          "description": "Number of helpful votes"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["productId", "rating", "customerName", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Store verified admin users"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store application orders"
    },
    "/price_alerts/{alertId}": {
      "schema": "PriceAlert",
      "description": "Store customer price drop alert subscriptions"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Store customer ratings and reviews"
    }
  }
}
