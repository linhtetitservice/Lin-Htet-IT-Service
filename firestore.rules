rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email.lower() == 'linhtetitservice0@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPriceAlert(data) {
      return data.keys().hasAll(['productId', 'productName', 'telegramId', 'currentPriceAtCreation', 'status']) &&
        data.keys().hasOnly(['productId', 'productName', 'telegramId', 'currentPriceAtCreation', 'targetPrice', 'status', 'createdAt', 'productImage', 'notifiedAt', 'triggeredPrice']) &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
        data.productName is string && data.productName.size() > 0 && data.productName.size() <= 200 &&
        data.telegramId is string && data.telegramId.size() > 0 && data.telegramId.size() <= 100 &&
        data.currentPriceAtCreation is number && data.currentPriceAtCreation >= 0 &&
        data.status in ['active', 'notified', 'cancelled'];
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'rating', 'customerName', 'comment', 'createdAt']) &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
        data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isBootstrappedAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // Price Alerts Collection
    match /price_alerts/{alertId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isValidPriceAlert(incoming());
      allow update, delete: if isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReview(incoming());
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
